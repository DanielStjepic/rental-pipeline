from collections.abc import Callable
from rental_pipeline import retry
from rental_pipeline.fda import TransientApiException, fetch_page
import requests
import pytest



def test_run_with_retry_output_no_retry(monkeypatch):
    number = 5
    calls = []
    def fake_returning_func():
        calls.append(number)
        return number

    monkeypatch.setattr(retry.time,'sleep', lambda seconds: None)
    result = retry.run_with_retry(fake_returning_func, retry_on=(TransientApiException, requests.Timeout, requests.ConnectionError))

    assert result == number
    assert len(calls) == 1

def test_run_with_retry_output_on_second(monkeypatch):
        number = 5
        calls = []
        def fake_returning_func():
            calls.append(number)
            if len(calls) == 1:
                raise TransientApiException
            else: 
                return number
            
        monkeypatch.setattr(retry.time,'sleep', lambda seconds: None)
        result = retry.run_with_retry(fake_returning_func, retry_on=(TransientApiException, requests.Timeout, requests.ConnectionError))
    
        assert result == number
        assert len(calls) == 2

def test_run_with_retry_raises_after_max_attempts(monkeypatch):
    number = 5
    calls = []
    def fake_returning_func():
        calls.append(number)
        raise TransientApiException

    monkeypatch.setattr(retry.time,'sleep', lambda seconds: None)
    with pytest.raises(TransientApiException):
        retry.run_with_retry(fake_returning_func, retry_on=(TransientApiException, requests.Timeout, requests.ConnectionError))
    assert len(calls) == 3
        

def test_run_with_retry_raises_not_listed_exception(monkeypatch):
    number = 5
    calls = []
    def fake_returning_func():
        calls.append(number)
        raise ValueError

    monkeypatch.setattr(retry.time,'sleep', lambda seconds: None)
    with pytest.raises(ValueError):
        retry.run_with_retry(fake_returning_func, retry_on=(TransientApiException, requests.Timeout, requests.ConnectionError))
    assert len(calls) == 1

        

